{
	"manifest_version": 3,
	"name": "New Tab X",
	"description": "Custom New Tab",
	"version": "3.4.0",
	"icons": {
		"128": "images/icon.png"
	},
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"homepage_url": "https://github.com/SuperZombi/new-tab-x",
	"permissions": ["storage", "geolocation"],
	"browser_specific_settings": {
		"gecko": {
			"id": "super.zombi@new.tab",
			"data_collection_permissions": { "required": ["none"] }
		}
	}
}
