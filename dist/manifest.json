{
	"manifest_version": 3,
	"name": "New Tab",
	"version": "1.0.0",
	"icons": {
		"128": "images/icon.png"
	},
	"description": "Custom New Tab",
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"homepage_url": "https://github.com/SuperZombi/custom-newtab",
	"permissions": ["storage"],
	"browser_specific_settings": {
		"gecko": {
			"id": "super.zombi@new.tab",
			"data_collection_permissions": { "required": ["none"] }
		}
	}
}
